<form action="/write" method="post">
  <div
    class="min-h-screen w-full flex flex-col justify-center items-center py-10 px-4 bg-transparent"
  >
    <div
      class="w-[90%] md:w-[65%] max-w-300 mx-auto bg-[#FAF7F2]/90 flex flex-col md:grid md:grid-cols-11 rounded-3xl px-7"
    >
      <div class="md:col-span-4 flex flex-col px-1 md:px-6 md:border-r md:border-stone-400 pt-3">
        <h1
          class="text-4xl font-extrabold font-['Lora'] mb-3 mt-6 text-[#2B1E16]"
        >
          Viết bức thư cho tương lai
        </h1>
        <p class="text-amber-900 font-['Lora']">
          Niêm phong tâm tư vào chiếc hộp thời gian. Một góc nhỏ bình yên gửi
          gắm đôi lời tới chính bạn của mai sau này.
        </p>
        <div class="flex flex-col gap-2 mt-10">
          <label
            for="email"
            class="flex items-center gap-2 text-md font-bold uppercase tracking-wider cursor-pointer text-[#4A3B32]"
          >
            <svg
              class="w-6 h-6 text-amber-500 shrink-0"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
            <span class="font-['Lora']">Email nhận</span>
          </label>
          <p class="<%=(typeof error!=='undefined'&&error==='email')?"text-red-500 text-sm":"hidden"%>">(Vui lòng chọn email nhận)</p>
          <input
            type="email"
            id="email"
            name="email"
            value="<%=(typeof error!=='undefined')?oldData.email:""%>"
            placeholder="you@example.com"
            class="w-full bg-white text-gray-800 placeholder-gray-400 font-serif px-4 py-3 rounded-t-2xl border border-gray-200 border-b-2 border-b-gray-400 focus:outline-none focus:border-amber-500"
          />
        </div>
        <div class="flex flex-col gap-2 mt-8">
          <div
            class="flex items-center gap-2 text-md font-bold uppercase tracking-wider mb-1 text-[#4A3B32]"
          >
            <svg
              class="w-6 h-6 text-amber-500 shrink-0"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <span class="font-['Lora']">gửi vào</span>
          </div>
          <p class="<%=(typeof error!=='undefined'&&error==='date')?"text-red-500 text-sm":"hidden"%>">(Vui lòng chọn 1 khoảng thời gian hoặc 1 thời điểm cụ thể)</p>
          <div class="grid grid-cols-3 gap-2">
            <label class="cursor-pointer">
              <input
                type="radio"
                name="deliver_in"
                value="6"
                <%= (oldData&&oldData.deliver_in === '6') ? 'checked' : '' %>
                class="radio-input hidden peer"
              />
              <span
                class="font-['Lora'] block text-center py-3 px-3 text-base font-semibold text-amber-950/80 bg-white border border-stone-200 rounded-2xl hover:bg-amber-100 peer-checked:bg-amber-200 peer-checked:border-amber-400"
              >
                6 Tháng
              </span>
            </label>

            <label class="cursor-pointer">
              <input
                type="radio"
                value="12"
                class="radio-input hidden peer"
                <%= (oldData.deliver_in === '12') ? 'checked' : '' %>
                name="deliver_in"
              />
              <span
                class="block text-center py-3 px-3 text-base font-['Lora'] font-semibold bg-white rounded-2xl border border-stone-200 text-amber-950/80 hover:bg-amber-100 peer-checked:bg-amber-200 peer-checked:border-amber-400"
              >
                1 Năm
              </span>
            </label>

            <label class="cursor-pointer">
              <input
                type="radio"
                name="deliver_in"
                value="36"
                <%= (oldData&&oldData.deliver_in === '36') ? 'checked' : '' %>
                class="radio-input hidden peer"
              />
              <span
                class="block text-center py-3 px-3 text-base font-['Lora'] font-semibold text-amber-950/80 bg-white border border-stone-200 rounded-2xl hover:bg-amber-100 peer-checked:bg-amber-200 peer-checked:border-amber-400"
              >
                3 Năm
              </span>
            </label>
          </div>
        </div>
        <label class="relative mt-3">
          <button
            type="button"
            id="choose-date-btn"
            class="relative w-full flex items-center justify-center gap-2 py-2.5 px-4 text-base font-serif text-amber-950/80 bg-white hover:bg-amber-100 border border-stone-200 rounded-full cursor-pointer"
            onclick=""
          >
            <span id="date-label-text" class="font-['Lora']">
              Chọn một ngày cụ thể
            </span>
            <svg
              class="w-6 h-6 text-[#6E5D4F]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
          </button>
          <div class="absolute top-0 left-0 right-0 bottom-0">
              <input
                type="date"
                id="specific_date"
                name="specific_date"
                class="text-lg relative w-full h-full opacity-0"
                value="<%=(typeof err!=='undefined'&&oldData.specific_date)?oldData.specific_date:""%>"
                onchange="
                  if (this.value) {
                    document
                      .getElementById('date-label-text')
                      .classList.add('font-semibold');
    
                    document.getElementById('date-label-text').innerText =
                      this.value;
                    document
                      .getElementById('choose-date-btn')
                      .classList.remove('bg-white');
                    document
                      .getElementById('choose-date-btn')
                      .classList.add('bg-amber-100');
                  }
                "
              />
          </div>
        </label>
        <span class="text-stone-500">(Thư sẽ được gửi vào 8:00 sáng)</span>
        <label class="cursor-pointer my-10">
          <div class="flex items-center">
            <div class="relative mr-3">
              <input
                type="checkbox"
                name="public"
                class="sr-only peer"
                <%= (oldData&&oldData.public) ? 'checked' : '' %>
                value="1"
              />

              <span
                class="block w-10 h-6 bg-stone-300 rounded-full peer-focus:outline-amber-200 peer-checked:bg-amber-500 after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:rounded-full after:bg-white after:border after:border-gray-300 after:transition-all peer-checked:after:translate-x-4.25 peer-checked:after:border-amber-500"
              ></span>
            </div>
            <p class="text-amber-950/80 text-base font-semibold">
              Công khai thư của tôi
              <br />
              (Ẩn danh)
            </p>
          </div>
        </label>
      </div>
      <div class="md:col-span-7 px-1 md:px-6 pt-3">
        <span class="font-['Playball'] text-2xl text-stone-500 block mt-6 mb-3">
          Gửi "tôi" của tương lai,
        </span>
        <textarea
          id="content-input"
          name="content"
          placeholder="Hãy bắt đầu bức thư của bạn ngay tại đây... Bạn đang cảm thấy thế nào? Có dự định đạt được thành tựu gì không?
          "
          class="mb-15 overflow-hidden md:overflow-auto resize-none w-full bg-transparent bg-local border-none outline-none text-2xl font-['Playball'] text-black placeholder-gray-900/80 leading-10 pb-8 min-h-50 md:min-h-100"
          style="
            background-image: repeating-linear-gradient(
              transparent 0px,
              transparent 38.5px,
              rgba(0, 0, 0, 0.3) 38.5px,
              rgba(0, 0, 0, 0.3) 40px
            );
          "
        ><%= (typeof error !== 'undefined' && oldData?.content) ? oldData.content : '' %></textarea>
          <p class="<%=(typeof error!=='undefined'&&error==='content')?"text-red-500 text-center font-['PlayBall'] text-xl mb-3":"hidden"%>">Đừng để bức thư trống trải nhé!</p>

        <button
          type="submit"
          class="flex items-center mx-auto px-10 py-3 mb-2 bg-[#E07A2B] rounded-full cursor-pointer duration-300 ease-out hover:scale-105 hover:shadow-xl active:scale-95"
        >
          <span class="text-lg mx-2 font-semibold font-['Lora'] text-white">
            Gửi tới tương lai
          </span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="text-white"
          >
            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
            <path
              d="M4.698 4.034l16.302 7.966l-16.302 7.966a.503 .503 0 0 1 -.546 -.124a.555 .555 0 0 1 -.12 -.568l2.468 -7.274l-2.468 -7.274a.555 .555 0 0 1 .12 -.568a.503 .503 0 0 1 .546 -.124"
            />
            <path d="M6.5 12h14.5" />
          </svg>
        </button>
        <p
          class="font-['Lora'] font-semibold text-amber-950/80 mx-auto text-center text-sm mb-10"
        >
          Từng con chữ của bạn sẽ được niêm phong an toàn
          <br />
          cho đến ngày hẹn tới.
        </p>
      </div>
    </div>
  </div>
</form>
